{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${mod_credits}"
  ],
  "contact": {
    "issues": "${mod_issue_tracker}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
    ],
    "client": [
      "me.clefal.lootbeams.loaders.fabric.FabricEntryPoint"
    ]
  },
  "custom": {
    "fzzy_config": [
      "${mod_id}"
    ]
  },
  "depends": {
    "fabricloader": ">=${target_fabricloader}",
    "fabric-api": "*",
    "minecraft": "=${target_minecraft}"
  }
}